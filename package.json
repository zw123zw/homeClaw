{
  "name": "homeclaw",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "dev:mock": "pnpm --filter @homeclaw/mock-server dev",
    "dev:web": "pnpm --filter @homeclaw/web dev",
    "dev:desktop": "pnpm --filter @homeclaw/desktop dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "desktop": "node tools/start-desktop.mjs",
    "build:web": "cd apps/web && node --import ./esbuild-register.mjs build.mjs",
    "build:backend": "node --import ./apps/web/esbuild-register.mjs tools/build-backend.mjs",
    "build:desktop": "cd apps/desktop && npx tsc -p tsconfig.main.json",
    "package": "npm run build:backend && npm run build:desktop && npm run build:web && node tools/package-app.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
